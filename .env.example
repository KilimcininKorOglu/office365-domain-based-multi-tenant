# Exchange Online Configuration
# Copy this file to .env and fill in your values

# Tenant Configuration
TENANT_DOMAIN=contoso.onmicrosoft.com
ADMIN_USER=admin@contoso.onmicrosoft.com

# Domain List File Path (use OS-appropriate path)
# Windows: C:\domains.txt
# macOS/Linux: /path/to/domains.txt
DOMAIN_LIST_FILE=C:\domains.txt

# Catch-All Configuration
CATCHALL_PREFIX=catchall
REDIRECT_USER=postmaster

# Authentication mode: interactive | device | certificate
#   interactive  — opens default browser; needs MFA each run
#   device       — prints a code; paste it on https://microsoft.com/devicelogin
#   certificate  — app-only auth using a self-signed cert (run Exc-CertSetup.ps1 first)
AUTH_MODE=interactive

# Legacy flag (overrides AUTH_MODE when set to true). Kept for backwards compatibility.
USE_DEVICE_CODE=false

# Keep the Exchange Online session open after the script finishes.
# Useful when chaining multiple scripts via dot-source in one pwsh session
# to avoid re-authenticating between runs.
KEEP_SESSION=false

# Certificate-based app-only auth (only needed when AUTH_MODE=certificate)
APP_ID=
CERT_PFX_PATH=
CERT_PFX_PASSWORD=
